# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Database (Unix socket peer auth — no TCP, no password) ───────────────────
PGDATABASE=velocitee
PGUSER=velocitee
# PGHOST defaults to /var/run/postgresql — only override if needed

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
IP_HASH_SALT=replace-with-64-random-hex-chars

# ── Admin dashboard ───────────────────────────────────────────────────────────
ADMIN_USER=admin
# Generate hash with: node -e "require('bcryptjs').hash('yourpassword', 12).then(console.log)"
ADMIN_PASS=$2b$12$replace_this_with_real_bcrypt_hash

# ── Resend ────────────────────────────────────────────────────────────────────
# Sign up at https://resend.com, create an API key, verify velocit.ee domain
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Create an Audience called "velocit.ee Waitlist" in Resend → copy its ID here
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Notifications ─────────────────────────────────────────────────────────────
# Your personal email — receives a notification on each new signup
NOTIFY_PERSONAL_EMAIL=you@example.com
