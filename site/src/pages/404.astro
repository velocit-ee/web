---
import Base from "../layouts/Base.astro";
import Terminal from "../components/Terminal.astro";
import type { TerminalLine } from "../components/terminal.types";

const errorLines: TerminalLine[] = [
  { kind: "out", text: "[2026-04-28 12:00:00 UTC] HTTP 404", cls: "text-warn" },
  { kind: "out", text: "  request:  GET " + (Astro.url.pathname || "/") },
  { kind: "out", text: "  status:   not in route table", cls: "text-muted" },
  { kind: "out", text: "  closest:  /engines  /pricing  /about", cls: "text-text" },
  { kind: "blank" },
  { kind: "out", text: "hint: try one of the routes above, or", cls: "text-muted" },
  { kind: "out", text: "      docs.velocit.ee for technical content.", cls: "text-muted" },
];
---
<Base
  title="404 — velocit.ee"
  description="Page not found."
  noindex={true}
>
  <section>
    <div class="mx-auto max-w-wrap px-6 lg:px-10 py-24 grid lg:grid-cols-[1.1fr,1fr] gap-12 items-start">
      <div>
        <p class="label">// HTTP 404</p>
        <h1 class="mt-3 font-mono text-5xl md:text-6xl text-cream tracking-tightest leading-[1.05]">
          file not found.<br/>
          <span class="text-cyan">probably never existed.</span>
        </h1>
        <p class="mt-6 max-w-[58ch] font-sans text-muted leading-relaxed">
          The URL you followed doesn't match any page we've shipped. If you got here from a link
          we own and it's broken, please tell us — <a href="mailto:inquiries@velocit.ee" class="text-green-hi underline-offset-2 hover:text-cream hover:underline">inquiries@velocit.ee</a>.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/" class="bg-green text-bg font-semibold text-sm px-5 py-2.5 hover:bg-green-hi transition-colors">go home</a>
          <a href="/engines" class="border border-green text-green-hi text-sm px-5 py-2.5 hover:bg-green hover:text-bg transition-colors">explore engines</a>
        </div>
      </div>
      <Terminal
        title="error.log"
        showCursor={false}
        startMs={120}
        stepMs={60}
        lines={errorLines}
      />
    </div>
  </section>
</Base>
