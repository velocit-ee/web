---
import Base from "../../layouts/Base.astro";
import Pipeline from "../../components/Pipeline.astro";

const engines = [
  {
    tag: "VME", phase: 1, name: "metal",
    status: "live",
    blurb: "PXE-boot any x86_64 hardware, install Proxmox VE or Ubuntu Server fully unattended, write a handoff manifest, tear down the seed stack.",
    deps: "none — entry point",
    repo: "velocit-ee/core/vme",
    href: "/engines/vme",
  },
  {
    tag: "VNE", phase: 2, name: "network",
    status: "live",
    blurb: "Take a provisioned Proxmox host and configure the network on top — OPNsense VM, VLANs, DHCP, DNS, firewall — declarative and idempotent.",
    deps: "VME manifest",
    repo: "velocit-ee/core/vne",
    href: "/engines/vne",
  },
  {
    tag: "VSE", phase: 3, name: "services",
    status: "next",
    blurb: "Containerised stack deployment. PostgreSQL, NGINX, Vaultwarden, monitoring — defined in velocitee.yml, deployed idempotently on top of VNE’s network.",
    deps: "VNE manifest",
    repo: "velocit-ee/core/vse",
    href: "/engines/vse",
  },
  {
    tag: "VLE", phase: 4, name: "lifecycle",
    status: "planned",
    blurb: "Drift detection against your config-as-truth. Auto-generated documentation. Single-command repair when reality diverges from intent.",
    deps: "VSE manifest",
    repo: "velocit-ee/core/vle",
    href: "/engines/vle",
  },
];

const statusBadge = (s: string) =>
  s === "live"    ? { text: "LIVE",    cls: "text-ok" } :
  s === "next"    ? { text: "NEXT",    cls: "text-warn" } :
                    { text: "PLANNED", cls: "text-muted" };
---
<Base title="engines — velocit.ee" description="Four engines, one pipeline. Each one independently useful: VME (metal), VNE (network), VSE (services), VLE (lifecycle).">
  <section class="border-b border-border">
    <div class="mx-auto max-w-wrap px-6 lg:px-10 py-16 lg:py-20">
      <p class="label">// the engines</p>
      <h1 class="mt-3 font-mono text-4xl md:text-5xl text-cream tracking-tightest leading-[1.05] max-w-[26ch]">
        four engines compose<br/>the whole pipeline.
      </h1>
      <p class="mt-5 max-w-[60ch] font-sans font-light text-muted text-sm leading-relaxed">
        Each engine does one thing, writes a structured handoff manifest, and passes it to the next.
        Pick up wherever your hardware already is — every engine is independently useful.
        Re-running any engine is safe: state is versioned, every step is idempotent.
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-wrap px-6 lg:px-10 py-14">
      <Pipeline />
    </div>
  </section>

  <section class="border-t border-border bg-surface/30">
    <div class="mx-auto max-w-wrap px-6 lg:px-10 py-16">
      <ul class="grid gap-6 lg:grid-cols-2">
        {engines.map((e) => {
          const badge = statusBadge(e.status);
          return (
            <li>
              <a href={e.href} class="tile block group hover:!border-green-hi transition-colors">
                <div class="tile-bar">
                  <span class={"dot " + (e.status === "live" ? "dot-ok" : e.status === "next" ? "dot-warn" : "")}></span>
                  <span>phase {e.phase} · {e.tag}</span>
                  <span class="spacer"></span>
                  <span class={badge.cls + " font-medium"}>{badge.text}</span>
                </div>
                <div class="p-6 lg:p-7">
                  <div class="flex items-baseline gap-3">
                    <h2 class="text-cream font-mono text-3xl font-semibold tracking-tightest">{e.tag}</h2>
                    <span class="text-muted text-sm">— {e.name}</span>
                  </div>
                  <p class="mt-3 text-muted font-sans text-sm leading-relaxed max-w-[54ch]">{e.blurb}</p>
                  <dl class="mt-5 grid grid-cols-2 gap-4 font-mono text-2xs">
                    <div>
                      <dt class="text-dim">depends on</dt>
                      <dd class="text-text mt-1">{e.deps}</dd>
                    </div>
                    <div>
                      <dt class="text-dim">repo path</dt>
                      <dd class="text-text mt-1">{e.repo}</dd>
                    </div>
                  </dl>
                  <div class="mt-6 text-2xs text-green-hi/80 group-hover:text-green-hi transition-colors">
                    read about {e.tag} →
                  </div>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</Base>
