---
import Base from "../layouts/Base.astro";
import Tile from "../components/Tile.astro";
---
<Base title="contact — velocit.ee" description="Get in touch with velocit.ee — questions, partnerships, nonprofit pricing, security disclosures.">
  <section>
    <div class="mx-auto max-w-wrap px-6 lg:px-10 py-16">
      <p class="label">// contact</p>
      <h1 class="mt-3 font-mono text-4xl md:text-5xl text-cream tracking-tightest leading-[1.05] max-w-[26ch]">
        say hello.<br/>or yell at us.<br/>both fine.
      </h1>
      <p class="mt-5 max-w-[58ch] font-sans font-light text-muted text-sm leading-relaxed">
        Email is the fastest way. The form below routes to the same inbox —
        <a href="mailto:inquiries@velocit.ee" class="text-green-hi underline-offset-2 hover:text-cream hover:underline">inquiries@velocit.ee</a>.
        We read every message and reply within a couple of business days, usually faster.
      </p>
    </div>
  </section>

  <section class="border-y border-border bg-surface/30">
    <div class="mx-auto max-w-wrap px-6 lg:px-10 py-16 grid lg:grid-cols-[1.2fr,1fr] gap-12">
      <form
        id="contact-form"
        action="/api/contact"
        method="post"
        novalidate
        class="space-y-5"
      >
        <div class="grid sm:grid-cols-2 gap-5">
          <label class="block">
            <span class="block text-2xs text-muted tracking-widest uppercase mb-2">name</span>
            <input
              required name="name" type="text" autocomplete="name"
              minlength="2" maxlength="120"
              class="w-full bg-surface border border-border text-cream font-mono text-sm px-3 py-2 focus:border-green focus:outline-none transition-colors"
            />
          </label>
          <label class="block">
            <span class="block text-2xs text-muted tracking-widest uppercase mb-2">email</span>
            <input
              required name="email" type="email" autocomplete="email"
              maxlength="320"
              class="w-full bg-surface border border-border text-cream font-mono text-sm px-3 py-2 focus:border-green focus:outline-none transition-colors"
            />
          </label>
        </div>
        <label class="block">
          <span class="block text-2xs text-muted tracking-widest uppercase mb-2">organisation <span class="text-dim normal-case tracking-normal">(optional)</span></span>
          <input
            name="organization" type="text" autocomplete="organization" maxlength="200"
            class="w-full bg-surface border border-border text-cream font-mono text-sm px-3 py-2 focus:border-green focus:outline-none transition-colors"
          />
        </label>
        <label class="block">
          <span class="block text-2xs text-muted tracking-widest uppercase mb-2">message</span>
          <textarea
            required name="message" rows="6" minlength="10" maxlength="4000"
            class="w-full bg-surface border border-border text-cream font-mono text-sm leading-relaxed px-3 py-2 focus:border-green focus:outline-none transition-colors resize-y"
          ></textarea>
        </label>
        {/* honeypot — keep visually but make it a no-go for humans (zero opacity, off-screen) */}
        <label class="absolute -left-[9999px] opacity-0 pointer-events-none" aria-hidden="true">
          <span>website</span>
          <input name="website" type="text" tabindex="-1" autocomplete="off" />
        </label>
        <div class="flex flex-wrap items-center gap-4 pt-1">
          <button
            type="submit"
            class="bg-green text-bg font-semibold text-sm px-5 py-2.5 hover:bg-green-hi transition-colors disabled:opacity-50"
          >
            send message →
          </button>
          <p id="contact-msg" class="text-2xs text-muted font-mono" role="status" aria-live="polite">
            <span class="text-dim">&gt; </span>plaintext only — no tracking, no GDPR small print to fight.
          </p>
        </div>
        <label class="flex items-start gap-2 text-xs text-muted mt-2 cursor-pointer">
    <input type="checkbox" name="consent" required class="mt-0.5 w-4 h-4 rounded border-border bg-surface text-blue focus:ring-blue cursor-pointer" />
    <span>I consent to the collection of this data and agree to the <a href="/legal/privacy" class="text-blue hover:underline">Privacy Policy</a>.</span>
  </label>
</form>

      <aside class="space-y-5">
        <Tile title="general inquiries" status="ok">
          <p class="text-cream font-mono text-sm">inquiries@velocit.ee</p>
          <p class="mt-2 text-muted text-2xs font-sans leading-relaxed">
            Most things land here. We read every message.
          </p>
        </Tile>
        <Tile title="legal · contracts" status="ok">
          <p class="text-cream font-mono text-sm">legal@velocit.ee</p>
          <p class="mt-2 text-muted text-2xs font-sans leading-relaxed">
            Commercial licensing, CLA questions, partnership paperwork.
          </p>
        </Tile>
        <Tile title="security disclosures" status="warn">
          <p class="text-cream font-mono text-sm">security@velocit.ee</p>
          <p class="mt-2 text-muted text-2xs font-sans leading-relaxed">
            Vulnerability reports. PGP key on
            <a href="https://github.com/velocit-ee/.github" class="text-green-hi underline-offset-2 hover:underline" target="_blank" rel="noopener">github</a>.
          </p>
        </Tile>
        <Tile title="github discussions" status="ok">
          <p class="text-muted text-sm font-sans leading-relaxed">
            Best for technical questions about the engines —
            <a href="https://github.com/velocit-ee/core/discussions" target="_blank" rel="noopener"
               class="text-green-hi underline-offset-2 hover:text-cream hover:underline">velocit-ee/core/discussions</a>.
          </p>
        </Tile>
      </aside>
    </div>
  </section>

  <script is:inline>
    (function () {
      var form = document.getElementById("contact-form");
      var msg  = document.getElementById("contact-msg");
      if (!form || !msg) return;
      form.addEventListener("submit", async function (ev) {
        ev.preventDefault();
        var btn = form.querySelector("button[type=submit]");
        var data = Object.fromEntries(new FormData(form).entries());
        msg.innerHTML = '<span style="color:#5e7055">&gt; </span>sending …';
        btn.disabled = true;
        try {
          var r = await fetch("/api/contact", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          var body = await r.json().catch(function () { return {}; });
          if (r.ok && body.success) {
            msg.innerHTML = '<span style="color:#7dc48a">✓  </span>' + (body.message || "thanks — we'll be in touch.");
            form.reset();
          } else {
            msg.innerHTML = '<span style="color:#a85a5a">✕  </span>' + (body.message || "something went wrong.");
          }
        } catch (err) {
          msg.innerHTML = '<span style="color:#a85a5a">✕  </span>network error. try again, or email inquiries@velocit.ee.';
        } finally {
          btn.disabled = false;
        }
      });
    })();
  </script>
</Base>
