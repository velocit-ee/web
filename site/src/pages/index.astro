---
import Base from "../layouts/Base.astro";
import HeroCanvas from "../components/HeroCanvas.astro";
import Pipeline from "../components/Pipeline.astro";
import MacWindow from "../components/MacWindow.astro";
import StatusPill from "../components/StatusPill.astro";

const features = [
  { tag: "Provisioner agnostic", title: "Your tool, your choice",
    body: "Switch between velocitee-native, OpenTofu, Ansible, or any supported backend in a single config line." },
  { tag: "Zero raw config",      title: "One YAML to rule them",
    body: "Users never touch HCL, playbooks, or CLI flags. velocitee.yml is the only interface they need." },
  { tag: "Verified deploys",     title: "Hard verification gates",
    body: "Each engine verifies success before passing its manifest forward. No silent failures." },
  { tag: "Open core",            title: "Apache 2.0 engines",
    body: "All four engines are open source. The SaaS config layer is optional — run entirely self-hosted." },
  { tag: "Idempotent",           title: "Safe to re-run always",
    body: "Every operation checks state before acting. Interrupted deployments resume from the last successful step." },
  { tag: "Lightweight",          title: "Minimal seed footprint",
    body: "VME runs on a wider hardware range than heavyweight provisioning suites with a fraction of the overhead." },
];
---
<Base>
  <!-- ─────────────────────────────────────────────────────────────────────
       HERO — canvas backdrop + two-column layout
       ───────────────────────────────────────────────────────────────────── -->
  <section class="hero-scene min-h-[560px]">
    <HeroCanvas />
    <div class="mist-bottom"></div>

    <div class="hero-overlay grid lg:grid-cols-2 gap-10 max-w-wrap mx-auto px-6 lg:px-10 pt-20 pb-16 items-center">
      <!-- Left — text -->
      <div class="animate-textin">
        <div class="font-mono text-[0.65rem] uppercase tracking-[0.18em] text-green flex items-center gap-3 mb-4">
          <span class="w-5 h-px bg-green inline-block"></span>
          <span>Open-core infrastructure</span>
        </div>
        <h1 class="font-sans text-[clamp(2.4rem,5vw,4.2rem)] font-bold leading-[1.05] tracking-tightest text-cream mb-4">
          Deploy at<br/>
          <span class="text-blue-hi">full</span>
          <span class="text-green-hi">velocity</span>
        </h1>
        <p class="text-[1rem] text-muted max-w-[48ch] leading-relaxed mb-6">
          One config file. Four engines. A working network — for the orgs that need it most.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="https://docs.velocit.ee/getting-started/" class="btn-p">Deploy now</a>
          <a href="https://docs.velocit.ee/" class="btn-s">Read docs</a>
        </div>

        <div class="flex flex-wrap gap-2 mt-8 animate-pillin">
          <StatusPill tone="g" label="VME ready" />
          <StatusPill tone="b" label="VNE deploying" />
          <StatusPill tone="c" label="velocitee-native" />
        </div>
      </div>

      <!-- Right — hardware visual -->
      <div class="relative flex items-center justify-center min-h-[280px] animate-rackin">
        <img src="/assets/hardware/server-1u.svg"
             alt=""
             class="hw-asset absolute top-[8%] right-[4%] w-[120px] opacity-25"
             aria-hidden="true" />
        <img src="/assets/hardware/server-1u.svg"
             alt=""
             class="hw-asset absolute bottom-[8%] left-[4%] w-[100px] opacity-20"
             aria-hidden="true" />
        <img src="/assets/hardware/rack-server.svg"
             alt="Server rack"
             class="hw-asset relative w-[220px] opacity-65" />
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────────────────────────────────────
       PIPELINE
       ───────────────────────────────────────────────────────────────────── -->
  <div class="border-t border-border"></div>
  <section class="max-w-wrap mx-auto px-6 lg:px-10 py-20">
    <p class="sec-label mb-4">Architecture</p>
    <h2 class="text-[2rem] font-semibold tracking-tightest text-cream mb-12">
      Four engines. One pipeline.
    </h2>
    <Pipeline />
  </section>

  <!-- ─────────────────────────────────────────────────────────────────────
       DEMO — two MacWindow terminals
       ───────────────────────────────────────────────────────────────────── -->
  <div class="border-t border-border"></div>
  <section class="max-w-wrap mx-auto px-6 lg:px-10 py-20">
    <p class="sec-label mb-4">Demo</p>
    <h2 class="text-[2rem] font-semibold tracking-tightest text-cream mb-12">
      Watch it deploy.
    </h2>

    <div class="space-y-6">
      <MacWindow title="seed@velocitee — deploy" pulse>
        <span class="tl2" style="animation-delay:0.2s"><span class="tp">$</span> <span class="tc">velocitee deploy --config velocitee.yml</span></span>
        <span class="tl2" style="animation-delay:0.6s"><span class="ti">→</span> reading config <span class="td">velocitee.yml</span></span>
        <span class="tl2" style="animation-delay:1.0s"><span class="ti">→</span> provisioner <span class="tb">velocitee-native</span> selected</span>
        <span class="tl2" style="animation-delay:1.4s"><span class="tok">✓</span> VME complete — proxmox-01 provisioned <span class="td">[4m 12s]</span></span>
        <span class="tl2" style="animation-delay:1.8s"><span class="tb">▶</span> VNE starting — deploying OPNsense on proxmox-01</span>
        <span class="tl2" style="animation-delay:2.2s"><span class="tok">✓</span> VLANs up — servers:10 clients:20 mgmt:99</span>
        <span class="tl2" style="animation-delay:2.6s"><span class="tok">✓</span> verification passed <span class="td">— manifest written</span><span class="cur" style="animation-delay:3.2s; opacity:0;"></span></span>
        <Fragment slot="statusbar">
          <span class="sb-g">● live</span>
          <span class="sb-sep">|</span>
          <span class="sb-b">VNE</span><span>deploying</span>
          <span class="sb-sep">|</span>
          <span>6m 44s</span>
          <span class="sb-sep">|</span>
          <span>apache 2.0</span>
        </Fragment>
      </MacWindow>

      <MacWindow title="velocitee — verify.py" bodyClass="!leading-[1.9]">
        <span class="tl2" style="animation-delay:0.1s"><span class="td">────────────────────────────────────────</span></span>
        <span class="tl2" style="animation-delay:0.3s"><span class="tb"> VNE Verification Gate</span></span>
        <span class="tl2" style="animation-delay:0.5s"><span class="td">────────────────────────────────────────</span></span>
        <span class="tl2" style="animation-delay:0.8s"><span class="tok"> PASS</span>  OPNsense API reachable         <span class="td">200 OK</span></span>
        <span class="tl2" style="animation-delay:1.1s"><span class="tok"> PASS</span>  DNS resolving                 <span class="td">cloudflare.com → 104.16.x.x</span></span>
        <span class="tl2" style="animation-delay:1.4s"><span class="tok"> PASS</span>  Internet egress               <span class="td">curl 1.1.1.1 → 204ms</span></span>
        <span class="tl2" style="animation-delay:1.7s"><span class="tok"> PASS</span>  VLAN interfaces up            <span class="td">vlan10 vlan20 vlan99</span></span>
        <span class="tl2" style="animation-delay:2.0s"><span class="td">────────────────────────────────────────</span></span>
        <span class="tl2" style="animation-delay:2.3s"><span class="tok">✓</span> all checks passed — writing <span class="tb">vne/output/manifest.json</span><span class="cur" style="animation-delay:2.8s; opacity:0;"></span></span>
        <Fragment slot="statusbar">
          <span class="sb-g">● 4/4 passed</span>
          <span class="sb-sep">|</span>
          <span>no failures</span>
          <span class="sb-sep">|</span>
          <span class="sb-b">VSE</span><span>ready</span>
        </Fragment>
      </MacWindow>
    </div>
  </section>

  <!-- ─────────────────────────────────────────────────────────────────────
       FEATURES
       ───────────────────────────────────────────────────────────────────── -->
  <div class="border-t border-border bg-surface/30">
    <section class="max-w-wrap mx-auto px-6 lg:px-10 py-20">
      <p class="sec-label mb-4">Why velocitee</p>
      <h2 class="text-[2rem] font-semibold tracking-tightest text-cream mb-12">
        Built for orgs with no IT team
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-border border border-border">
        {features.map((f) => (
          <div class="bg-surface p-8 relative overflow-hidden hover:bg-surface2 transition-colors group">
            <div class="absolute top-0 left-0 right-0 h-px opacity-0 group-hover:opacity-100 transition-opacity"
                 style="background: linear-gradient(90deg, var(--v-blue), transparent);"></div>
            <div class="font-mono text-[0.65rem] uppercase tracking-[0.15em] text-blue mb-4 flex items-center gap-2">
              <span class="inline-block w-[18px] h-[18px] border border-blue-lo bg-blue-dim shrink-0"></span>
              <span>{f.tag}</span>
            </div>
            <h3 class="font-semibold text-[0.95rem] text-cream mb-2 -tracking-[0.01em]">{f.title}</h3>
            <p class="text-[0.82rem] text-muted leading-[1.65]">{f.body}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>
