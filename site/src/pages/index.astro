---
import Base from "../layouts/Base.astro";
import Pipeline from "../components/Pipeline.astro";
import Terminal from "../components/Terminal.astro";
import Tile from "../components/Tile.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import type { TerminalLine } from "../components/terminal.types";

const yamlLines: TerminalLine[] = [
  { kind: "out", text: "velocitee:",                              cls: "text-cream" },
  { kind: "out", text: '  provisioner: "velocitee-native"',       cls: "text-text"  },
  { kind: "blank" },
  { kind: "out", text: "vne:",                                    cls: "text-cream" },
  { kind: "out", text: "  vlans:",                                cls: "text-text" },
  { kind: "out", text: "    - id: 10",                            cls: "text-text" },
  { kind: "out", text: '      name: "servers"',                   cls: "text-text" },
  { kind: "out", text: '      cidr: "10.10.10.0/24"',             cls: "text-text" },
  { kind: "out", text: '      dhcp_start: "10.10.10.100"',        cls: "text-text" },
  { kind: "out", text: '      dhcp_end:   "10.10.10.200"',        cls: "text-text" },
  { kind: "out", text: "  dns:",                                  cls: "text-text" },
  { kind: "out", text: '    upstream: ["1.1.1.1", "9.9.9.9"]',    cls: "text-text" },
  { kind: "out", text: '    domain: "lab.local"',                 cls: "text-text" },
  { kind: "out", text: "  firewall:",                             cls: "text-text" },
  { kind: "out", text: '    default_policy: "block"',             cls: "text-text" },
  { kind: "out", text: "    allow_rules:",                        cls: "text-text" },
  { kind: "out", text: "      - description: \"LAN to internet\"", cls: "text-text" },
  { kind: "out", text: "        src_vlan: 20",                    cls: "text-text" },
  { kind: "out", text: '        action: "allow"',                 cls: "text-text" },
];

const heroLines: TerminalLine[] = [
  { kind: "prompt", cwd: "~/lab", cmd: "vne deploy --manifest ./vme-manifest.json" },
  { kind: "out",    text: "[1/7] pre-flight: environment variables …", cls: "text-muted" },
  { kind: "out",    text: "[2/7] validating VME handoff manifest …",   cls: "text-muted" },
  { kind: "out",    text: "[3/7] validating velocitee.yml VNE block …", cls: "text-muted" },
  { kind: "out",    text: "[4/7] building renderer pipeline (velocitee-native) …", cls: "text-muted" },
  { kind: "out",    text: "[5/7] running pipeline …",                  cls: "text-muted" },
  { kind: "out",    text: "      proxmox: creating VM 100 on node pve", cls: "text-muted" },
  { kind: "out",    text: "      proxmox: starting VM 100",            cls: "text-muted" },
  { kind: "out",    text: "      opnsense: configuring VLANs (10, 20, 30)", cls: "text-muted" },
  { kind: "out",    text: "      opnsense: applying firewall …",       cls: "text-muted" },
  { kind: "out",    text: "[6/7] verification …",                      cls: "text-muted" },
  { kind: "ok",     text: "api_reachable    https://10.10.10.1 → 200" },
  { kind: "ok",     text: "dns_resolving    one.one.one.one via 10.10.10.1" },
  { kind: "ok",     text: "internet_egress  TCP 1.1.1.1:443 reached in 12 ms" },
  { kind: "ok",     text: "vlans_up         all 3 expected VLAN(s) present" },
  { kind: "out",    text: "[7/7] writing manifest → vne/output/proxmox-01.json", cls: "text-text" },
  { kind: "blank" },
  { kind: "out",    text: "VNE complete. Hand off to VSE next.", cls: "text-cream" },
];

const problems = [
  {
    n: "01",
    h: "Volunteers leave. Knowledge leaves with them.",
    p: "Most small-org infra is held together by one person who knows where the bodies are buried. When they move on, nobody can repair it.",
  },
  {
    n: "02",
    h: "Hand-rolled servers drift.",
    p: "Three months in, your staging looks nothing like production. Six months in, nobody can rebuild from scratch.",
  },
  {
    n: "03",
    h: "Enterprise tools assume an enterprise budget.",
    p: "MaaS-likes, paid CMDBs, and configuration platforms cost more than the hardware they manage. Small orgs can’t pay them. So they don’t.",
  },
  {
    n: "04",
    h: "Open-source tooling assumes you’re a sysadmin.",
    p: "Ansible and Terraform are great if you already speak them. velocitee gives you the same outcome from one config file.",
  },
];

const principles = [
  {
    t: "Correctness above all.",
    p: "Every operation is idempotent. Every phase has a verification gate. The system never lands in a half-configured state.",
  },
  {
    t: "Provisioner-agnostic.",
    p: "Pick your tool — velocitee-native, OpenTofu+Ansible, or contribute a renderer for yours. Engine logic doesn't change.",
  },
  {
    t: "Documented by construction.",
    p: "Every successful run produces a structured manifest. Your runbook isn't a wiki page someone forgot to update — it's the artifact your tooling already wrote.",
  },
  {
    t: "Open core. Always.",
    p: "Engines under AGPL v3. Self-hosted use is free, forever. The SaaS layer (AI config gen, registry) is what we charge for.",
  },
];
---
<Base>
  <!-- ─────────────────────────────────────────────────────────────────────
       HERO
       ───────────────────────────────────────────────────────────────────── -->
  <section class="relative">
    <div class="mx-auto max-w-wrap px-6 lg:px-10 pt-16 lg:pt-24 pb-16">
      <div class="grid lg:grid-cols-[1.05fr,1fr] gap-12 items-start">
        <div>
          <p class="label">// open-core infrastructure</p>
          <h1 class="mt-6 font-mono text-4xl md:text-5xl lg:text-6xl text-cream font-semibold leading-[1.04] tracking-tightest">
            networks that<br/>
            <span class="text-green-hi">survive</span> anyone<br/>
            <span class="text-brown-hi">leaving.</span>
          </h1>

          <p class="mt-7 max-w-[46ch] font-sans font-light text-text leading-relaxed">
            Small orgs deserve solid infrastructure. They just can’t afford to maintain it.
            <strong class="text-cream font-medium">velocitee is the pipeline that does the maintaining</strong> —
            four engines, one config file, every step idempotent and documented.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="https://docs.velocit.ee/getting-started/"
               class="bg-green text-bg font-semibold text-sm px-5 py-2.5 hover:bg-green-hi transition-colors">
              read the docs →
            </a>
            <a href="https://github.com/velocit-ee/core"
               class="border border-green text-green-hi text-sm px-5 py-2.5 hover:bg-green hover:text-bg transition-colors"
               target="_blank" rel="noopener">
              github
            </a>
          </div>

          <div class="mt-10 max-w-[44ch]">
            <p class="label">// stay in the loop</p>
            <WaitlistForm />
          </div>

          <!-- stat strip -->
          <div class="mt-14 grid grid-cols-3 gap-6 max-w-[36rem] border-t border-border pt-6">
            <div>
              <div class="text-cream text-2xl font-mono font-semibold leading-none tracking-tightest">
                <span class="text-green-hi">2</span><span class="text-dim">/4</span>
              </div>
              <div class="mt-1 text-2xs text-muted">engines live</div>
            </div>
            <div>
              <div class="text-cream text-2xl font-mono font-semibold leading-none tracking-tightest">15</div>
              <div class="mt-1 text-2xs text-muted">provisioner backends</div>
            </div>
            <div>
              <div class="text-cream text-2xl font-mono font-semibold leading-none tracking-tightest">AGPL<span class="text-green-hi"> v3</span></div>
              <div class="mt-1 text-2xs text-muted">free forever, self-hosted</div>
            </div>
          </div>
        </div>

        <div class="lg:pt-12">
          <Terminal title="vne deploy" lines={heroLines} startMs={300} stepMs={70} />
          <p class="mt-3 text-2xs text-muted font-log">
            <span class="text-dim">›</span> the actual VNE engine — try it on your own hardware in ~10 minutes.
          </p>
        </div>
      </div>
    </div>

    <!-- corner glyph: terminal-style file path indicator, anchored to viewport -->
    <div aria-hidden="true"
         class="hidden xl:block fixed left-2 top-1/2 -translate-y-1/2 z-10
                font-log text-2xs text-dim leading-tight rotate-180 [writing-mode:vertical-rl]">
      ~/velocit.ee/index.astro · main · clean
    </div>
  </section>

  <!-- ─────────────────────────────────────────────────────────────────────
       PIPELINE
       ───────────────────────────────────────────────────────────────────── -->
  <section class="relative border-t border-border bg-surface/30">
    <div class="mx-auto max-w-wrap px-6 lg:px-10 py-20">
      <div class="flex items-baseline justify-between gap-4 flex-wrap mb-8">
        <div>
          <p class="label">// the pipeline</p>
          <h2 class="mt-3 font-mono text-3xl md:text-4xl text-cream tracking-tightest leading-[1.05] max-w-[24ch]">
            four engines. one config file. each one independently useful.
          </h2>
        </div>
        <a href="/engines" class="text-sm text-green-hi hover:text-cream transition-colors">explore engines →</a>
      </div>
      <Pipeline />
    </div>
  </section>

  <!-- ─────────────────────────────────────────────────────────────────────
       PROBLEM
       ───────────────────────────────────────────────────────────────────── -->
  <section class="relative">
    <div class="mx-auto max-w-wrap px-6 lg:px-10 py-20">
      <p class="label">// the problem</p>
      <h2 class="mt-3 font-mono text-3xl md:text-4xl text-cream tracking-tightest leading-[1.1] max-w-[28ch]">
        small orgs deserve solid infrastructure. they just can’t afford to maintain it.
      </h2>
      <ul class="mt-10 grid gap-px bg-border border border-border md:grid-cols-2">
        {problems.map((p) => (
          <li class="bg-surface p-6 lg:p-7 group hover:bg-surface2 transition-colors">
            <div class="flex items-start gap-4">
              <span class="font-log text-2xs text-dim w-8 pt-1 shrink-0">{p.n}</span>
              <div>
                <h3 class="text-cream font-mono text-base font-semibold tracking-tightest mb-1">{p.h}</h3>
                <p class="text-muted font-sans text-sm leading-relaxed max-w-[52ch]">{p.p}</p>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─────────────────────────────────────────────────────────────────────
       HOW IT WORKS — terminal + bullet list pair
       ───────────────────────────────────────────────────────────────────── -->
  <section class="relative border-t border-border bg-surface/30">
    <div class="mx-auto max-w-wrap px-6 lg:px-10 py-20 grid lg:grid-cols-[1fr,1.1fr] gap-12 items-start">
      <div>
        <p class="label">// how it works</p>
        <h2 class="mt-3 font-mono text-3xl md:text-4xl text-cream tracking-tightest leading-[1.1] max-w-[20ch]">
          describe your hardware. get your stack. run one command.
        </h2>
        <ul class="mt-8 space-y-5 text-muted font-sans text-sm leading-relaxed max-w-[52ch]">
          <li class="flex gap-3">
            <span class="text-green shrink-0 pt-1">→</span>
            <p><strong class="text-text font-medium">Write a velocitee.yml</strong> — your network, services, and lifecycle expectations as plain config. Pydantic-validated; typos fail fast.</p>
          </li>
          <li class="flex gap-3">
            <span class="text-green shrink-0 pt-1">→</span>
            <p><strong class="text-text font-medium">Pick a provisioner.</strong> velocitee-native (Python), OpenTofu + Ansible, or any of 13 reserved backends. Same intent, different runners.</p>
          </li>
          <li class="flex gap-3">
            <span class="text-green shrink-0 pt-1">→</span>
            <p><strong class="text-text font-medium">Run the engines.</strong> Each writes a structured handoff manifest. Skip phases you don’t need; resume any that interrupt.</p>
          </li>
          <li class="flex gap-3">
            <span class="text-green shrink-0 pt-1">→</span>
            <p><strong class="text-text font-medium">Done = documented.</strong> The handoff manifest *is* your runbook. Drift detection in VLE catches it when reality diverges.</p>
          </li>
        </ul>
        <a href="https://docs.velocit.ee/getting-started/"
           class="inline-block mt-9 text-sm text-green-hi border-b border-green-hi/40 hover:border-cream hover:text-cream transition-colors">
          full getting-started guide →
        </a>
      </div>

      <Terminal
        title="velocitee.yml — VNE block (excerpt)"
        startMs={150}
        stepMs={45}
        showCursor={false}
        lines={yamlLines}
      />
    </div>
  </section>

  <!-- ─────────────────────────────────────────────────────────────────────
       PRINCIPLES
       ───────────────────────────────────────────────────────────────────── -->
  <section class="relative">
    <div class="mx-auto max-w-wrap px-6 lg:px-10 py-20">
      <p class="label">// principles</p>
      <h2 class="mt-3 font-mono text-3xl md:text-4xl text-cream tracking-tightest leading-[1.1] max-w-[28ch]">
        what we will and won't build for you.
      </h2>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {principles.map((it, i) => (
          <Tile title={`0${i + 1} ` + (i % 2 === 0 ? "principle:active" : "principle:active")} status="ok">
            <h3 class="text-cream font-mono text-base font-semibold tracking-tightest">{it.t}</h3>
            <p class="mt-2 text-muted font-sans text-sm leading-relaxed">{it.p}</p>
          </Tile>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────────────────────────────────────
       CTA
       ───────────────────────────────────────────────────────────────────── -->
  <section class="relative border-t border-border bg-surface/40">
    <div class="mx-auto max-w-wrap px-6 lg:px-10 py-20 text-center">
      <p class="label">// VME is available now.</p>
      <h2 class="mt-4 font-mono text-3xl md:text-4xl lg:text-5xl text-cream tracking-tightest leading-[1.05] max-w-[22ch] mx-auto">
        run one command. install everything. walk away.
      </h2>
      <p class="mt-5 max-w-[44ch] mx-auto font-sans font-light text-muted text-sm leading-relaxed">
        VME is the metal phase. Plug a target machine in, point it at the seed stack, walk away.
        Comes back as Proxmox VE or Ubuntu Server, fully provisioned, with a manifest you can hand to the next engine.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="https://docs.velocit.ee/vme/getting-started/"
           class="bg-green text-bg font-semibold text-sm px-5 py-2.5 hover:bg-green-hi transition-colors">
          getting started with VME →
        </a>
        <a href="https://github.com/velocit-ee/core"
           class="border border-green text-green-hi text-sm px-5 py-2.5 hover:bg-green hover:text-bg transition-colors"
           target="_blank" rel="noopener">
          read the source
        </a>
      </div>
    </div>
  </section>
</Base>
