---
const year = new Date().getUTCFullYear();
const links = [
  { href: "https://github.com/velocit-ee",       label: "GitHub",     external: true },
  { href: "https://docs.velocit.ee/",            label: "Docs",       external: true },
  { href: "https://www.apache.org/licenses/LICENSE-2.0", label: "Apache 2.0", external: true },
  { href: "/contact",                            label: "Contact" },
];
---
<footer class="border-t border-border px-6 lg:px-10 py-6 flex flex-wrap gap-4 items-center justify-between font-mono text-[0.65rem] uppercase tracking-[0.06em] text-dim">
  <div class="text-blue-hi">velocit.ee</div>
  <div class="flex gap-6 flex-wrap">
    {links.map((l) => (
      <a
        href={l.href}
        target={l.external ? "_blank" : undefined}
        rel={l.external ? "noopener" : undefined}
        class="text-dim hover:text-muted transition-colors"
      >{l.label}</a>
    ))}
  </div>
  <div class="whitespace-nowrap">© {year} velocitee</div>
</footer>
