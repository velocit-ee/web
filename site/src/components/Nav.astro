---
const { pathname } = Astro.url;
const links = [
  { href: "https://docs.velocit.ee/",      label: "Docs",      external: true },
  { href: "/engines",                       label: "Engines" },
  { href: "https://github.com/velocit-ee",  label: "GitHub",    external: true },
  { href: "/contact",                       label: "Community" },
];
function isActive(href: string) {
  if (href.startsWith("http")) return false;
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
}
---
<nav class="sticky top-0 z-[100] flex items-center justify-between h-[60px] px-6 lg:px-10 border-b border-border bg-bg/85 backdrop-blur-[14px]">
  <a href="/" class="font-mono text-[1.1rem] font-semibold tracking-tightest">
    <span class="text-blue-hi">v</span><span class="text-cream">elocit</span><span class="logo-ee">.ee</span>
  </a>

  <ul class="hidden md:flex gap-8 list-none font-mono text-[0.72rem] uppercase tracking-[0.08em]">
    {links.map((l) => (
      <li>
        <a
          href={l.href}
          target={l.external ? "_blank" : undefined}
          rel={l.external ? "noopener" : undefined}
          aria-current={isActive(l.href) ? "page" : undefined}
          class="text-muted hover:text-blue-hi transition-colors"
        >{l.label}</a>
      </li>
    ))}
  </ul>

  <a href="/contact"
     class="font-mono text-[0.72rem] uppercase tracking-[0.06em] py-[0.45rem] px-4 border border-blue text-blue-hi bg-blue-dim hover:bg-blue hover:!text-white transition-colors">
    Get Started
  </a>
</nav>
