---
// Animated canvas backdrop for the hero section.
//
// Renders, in order, every frame:
//   1. Solid base fill
//   2. Hairline 38px grid (very low opacity blue lines)
//   3. Five drifting "mist" radial blobs, blue/green alternating
//   4. Seven vertical falling "data streams"
//   5. ~85 particles with proximity-line connections
//   6. A horizontal velocity streak that sweeps every ~3s
//
// All sizing is computed from the canvas's offset size, so this component
// fits whatever section wraps it. ResizeObserver keeps it sharp through
// viewport changes. Honors prefers-reduced-motion (script bails out, leaves
// a static base fill in place).

interface Props {
  class?: string;
}
const { class: extraClass = "" } = Astro.props;
---
<canvas
  class:list={["hero-canvas", extraClass]}
  data-hero-canvas
  aria-hidden="true"
></canvas>

<script is:inline>
  (function () {
    const reduce = window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const canvas = document.querySelector("[data-hero-canvas]");
    if (!canvas) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let W = 0, H = 0, frame = 0;
    let particles = [], streams = [], blobs = [];

    function rgb(hex) {
      const r = parseInt(hex.slice(1, 3), 16);
      const g = parseInt(hex.slice(3, 5), 16);
      const b = parseInt(hex.slice(5, 7), 16);
      return r + "," + g + "," + b;
    }

    function init() {
      particles = Array.from({ length: 85 }, () => ({
        x:  Math.random() * W,
        y:  Math.random() * H,
        r:  Math.random() * 1.2 + 0.3,
        vx: (Math.random() - 0.5) * 0.18,
        vy: (Math.random() - 0.5) * 0.18,
        op: Math.random() * 0.4 + 0.05,
        c:  Math.random() > 0.6 ? "#3b82f6"
            : Math.random() > 0.5 ? "#22c55e" : "#22d3ee",
      }));
      streams = Array.from({ length: 7 }, (_, i) => ({
        x:   W * (0.1 + i * 0.13),
        y:   Math.random() * H,
        spd: Math.random() * 0.8 + 0.3,
        len: Math.random() * 80 + 40,
        op:  Math.random() * 0.18 + 0.04,
        c:   Math.random() > 0.5 ? "#3b82f6" : "#22c55e",
      }));
      blobs = Array.from({ length: 5 }, (_, i) => ({
        x:   W * (0.1 + i * 0.22),
        y:   H * (0.3 + Math.random() * 0.4),
        rx:  110 + Math.random() * 100,
        ry:  50 + Math.random() * 55,
        op:  0.016 + Math.random() * 0.02,
        ph:  Math.random() * Math.PI * 2,
        spd: 0.0004 + Math.random() * 0.0004,
        c:   i % 2 === 0 ? "#3b82f6" : "#22c55e",
      }));
    }

    function resize() {
      W = canvas.offsetWidth;
      H = canvas.offsetHeight;
      // High-DPI handled by simply matching pixel size to CSS size; we trade
      // a touch of crispness for a much simpler resize / paint pipeline.
      canvas.width  = W;
      canvas.height = H;
      init();
    }

    function paintStaticBase() {
      ctx.fillStyle = "#0d0d10";
      ctx.fillRect(0, 0, W, H);
      // Faint grid only — no animation
      const gs = 38;
      ctx.strokeStyle = "rgba(59,130,246,0.028)";
      ctx.lineWidth   = 0.5;
      for (let x = 0; x < W; x += gs) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();
      }
      for (let y = 0; y < H; y += gs) {
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
      }
    }

    function draw() {
      frame++;
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = "#0d0d10";
      ctx.fillRect(0, 0, W, H);

      // Grid
      const gs = 38;
      ctx.strokeStyle = "rgba(59,130,246,0.028)";
      ctx.lineWidth   = 0.5;
      for (let x = 0; x < W; x += gs) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();
      }
      for (let y = 0; y < H; y += gs) {
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
      }

      // Mist blobs
      blobs.forEach((b) => {
        b.ph += b.spd;
        const bx = b.x + Math.sin(b.ph * 1.3) * 18;
        const by = b.y + Math.cos(b.ph)       * 10;
        const g = ctx.createRadialGradient(bx, by, 0, bx, by, b.rx);
        g.addColorStop(0,   "rgba(" + rgb(b.c) + "," + b.op + ")");
        g.addColorStop(0.5, "rgba(" + rgb(b.c) + "," + b.op * 0.4 + ")");
        g.addColorStop(1,   "rgba(0,0,0,0)");
        ctx.save();
        ctx.scale(1, b.ry / b.rx);
        ctx.beginPath();
        ctx.arc(bx, by * (b.rx / b.ry), b.rx, 0, Math.PI * 2);
        ctx.fillStyle = g;
        ctx.fill();
        ctx.restore();
      });

      // Falling data streams
      streams.forEach((s) => {
        s.y += s.spd;
        if (s.y > H + s.len) s.y = -s.len;
        const g = ctx.createLinearGradient(s.x, s.y - s.len, s.x, s.y);
        g.addColorStop(0,   "rgba(0,0,0,0)");
        g.addColorStop(0.5, "rgba(" + rgb(s.c) + "," + s.op + ")");
        g.addColorStop(1,   "rgba(0,0,0,0)");
        ctx.strokeStyle = g;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(s.x, s.y - s.len);
        ctx.lineTo(s.x, s.y);
        ctx.stroke();
      });

      // Particles
      particles.forEach((p) => {
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0) p.x = W;
        if (p.x > W) p.x = 0;
        if (p.y < 0) p.y = H;
        if (p.y > H) p.y = 0;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = "rgba(" + rgb(p.c) + "," + p.op + ")";
        ctx.fill();
      });

      // Particle proximity lines
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        for (let j = i + 1; j < particles.length; j++) {
          const q = particles[j];
          const dx = p.x - q.x, dy = p.y - q.y;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < 80) {
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(q.x, q.y);
            ctx.strokeStyle = "rgba(59,130,246," + (0.06 * (1 - d / 80)) + ")";
            ctx.lineWidth = 0.4;
            ctx.stroke();
          }
        }
      }

      // Velocity streak — once every ~3s
      if (frame % 180 < 60) {
        const t  = (frame % 180) / 60;
        const sx = W * t;
        const sg = ctx.createLinearGradient(sx - 120, 0, sx + 80, 0);
        sg.addColorStop(0,   "rgba(0,0,0,0)");
        sg.addColorStop(0.4, "rgba(59,130,246,0.18)");
        sg.addColorStop(0.7, "rgba(34,197,94,0.14)");
        sg.addColorStop(1,   "rgba(0,0,0,0)");
        ctx.strokeStyle = sg;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(sx - 120, H * 0.22);
        ctx.lineTo(sx + 80,  H * 0.22);
        ctx.stroke();
      }

      requestAnimationFrame(draw);
    }

    if (reduce) {
      // Honor reduced motion — paint a single static frame, no animation loop.
      resize();
      paintStaticBase();
      return;
    }

    resize();
    draw();

    if (typeof ResizeObserver !== "undefined") {
      new ResizeObserver(resize).observe(canvas);
    } else {
      window.addEventListener("resize", resize);
    }
  })();
</script>
