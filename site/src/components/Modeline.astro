---
// vim-style status modeline. Sits above the footer on every page.
// The first segment shows the current path (`-- /pricing --`-ish), the second
// a fake build/run id, and the third a slow-pulsing ok dot.
const { pathname } = Astro.url;
const buildId = (
  // deterministic per-page short hash for the modeline so it doesn't flicker
  // on every render but still feels alive across pages
  String(pathname || "/")
    .split("")
    .reduce((acc, ch) => ((acc * 33) ^ ch.charCodeAt(0)) >>> 0, 5381)
    .toString(16)
    .padStart(7, "0")
    .slice(0, 7)
);
const ENGINES_LIVE = 2;
const ENGINES_TOTAL = 4;
---
<aside class="modeline" aria-hidden="false">
  <span class="seg seg-prim">
    <span class="pulse" aria-hidden="true"></span>
    <span>NORMAL</span>
  </span>
  <span class="seg">
    <span>buf:</span>
    <span class="text-cream">{pathname || "/"}</span>
  </span>
  <span class="seg seg-acc">
    <span>build:</span>
    <span>{buildId}</span>
  </span>
  <span class="seg">
    <span>engines:</span>
    <span class="text-green-hi">{ENGINES_LIVE}</span>
    <span>/{ENGINES_TOTAL}</span>
  </span>
  <span class="seg ml-auto">
    <span class="hidden sm:inline">utf-8</span>
    <span class="hidden sm:inline">·</span>
    <span class="hidden sm:inline">unix</span>
    <span class="hidden sm:inline">·</span>
    <span>v0.1.0</span>
  </span>
</aside>
