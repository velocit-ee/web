---
// Four-engine pipeline visualisation. A horizontal gradient line connects
// four square nodes; the active one wears a blue inner glow. Hover any node
// to preview its accent state.
//
// Stage names + descriptions can be overridden via props for engine-specific
// detail pages, but the default reflects the current production set.

interface Stage {
  tag: "VME" | "VNE" | "VSE" | "VLE";
  name: string;
  desc: string;
  href?: string;
  active?: boolean;
}
interface Props {
  stages?: Stage[];
}
const {
  stages = [
    { tag: "VME", name: "Metal Engine",     desc: "PXE boot, Proxmox install, hardware provisioning",       href: "/engines/vme", active: true },
    { tag: "VNE", name: "Network Engine",   desc: "OPNsense, VLANs, DHCP, DNS, firewall baseline",          href: "/engines/vne" },
    { tag: "VSE", name: "Services Engine",  desc: "Application deployment on provisioned infrastructure",   href: "/engines/vse" },
    { tag: "VLE", name: "Lifecycle Engine", desc: "Monitoring, drift detection, automated repair",          href: "/engines/vle" },
  ],
} = Astro.props as Props;
---
<div class="pipeline grid grid-cols-2 md:grid-cols-4 gap-x-0 gap-y-10 md:gap-y-0">
  {stages.map((s) => {
    const NodeTag = s.href ? "a" : "div";
    const props = s.href ? { href: s.href } : {};
    return (
      <div class="pipe-stage">
        <NodeTag
          {...props}
          class:list={[
            "pipe-node",
            s.active && "active",
            s.href && "cursor-pointer",
          ]}
        >{s.tag}</NodeTag>
        <div class="pipe-name">{s.name}</div>
        <div class="pipe-desc">{s.desc}</div>
      </div>
    );
  })}
</div>
