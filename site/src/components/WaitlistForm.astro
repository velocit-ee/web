---
// Waitlist signup. POSTs to /api/waitlist on the same origin (Express handles).
// All client logic is inline — no framework runtime needed.
---
<form
  id="wl-form"
  class="mt-2 flex flex-col gap-3 max-w-sm"
  action="/api/waitlist"
  method="post"
  novalidate
>
  <div class="flex gap-2 items-stretch w-full">
    <input
      type="email"
      name="email"
      required
      placeholder="you@example.org"
      autocomplete="email"
      class="bg-surface border border-border text-cream text-sm px-3 py-2 flex-1 focus:ring-2 focus:ring-blue focus:border-blue focus:outline-none transition-shadow rounded-sm"
    />
    <button
      type="submit"
      class="bg-blue text-white font-medium text-sm px-4 py-2 hover:bg-blue-hi transition-colors disabled:opacity-50 rounded-sm"
    >
      Join Waitlist
    </button>
  </div>
  
  <label class="flex items-start gap-2 text-xs text-muted mt-1 cursor-pointer">
    <input type="checkbox" name="consent" required class="mt-0.5 w-4 h-4 rounded border-border bg-surface text-blue focus:ring-blue cursor-pointer" />
    <span>
      I consent to receive marketing emails and agree to the <a href="/legal/privacy" class="text-blue hover:underline">Privacy Policy</a>.
    </span>
  </label>
  
  <p id="wl-msg"
     class="text-xs mt-1 text-muted min-h-[1.5rem]"
     role="status"
     aria-live="polite">
  </p>
</form>
<script is:inline>
  (function () {
    var form = document.getElementById("wl-form");
    var msg  = document.getElementById("wl-msg");
    if (!form || !msg) return;
    form.addEventListener("submit", async function (ev) {
      ev.preventDefault();
      var email = (form.email && form.email.value || "").trim();
      var consent = form.consent && form.consent.checked;
      var btn   = form.querySelector("button[type=submit]");
      
      if (!email) {
        msg.innerHTML = '<span style="color:#ef4444">✕ </span>Email is required.';
        return;
      }
      if (!consent) {
        msg.innerHTML = '<span style="color:#ef4444">✕ </span>You must agree to the Privacy Policy.';
        return;
      }

      msg.innerHTML = '<span style="color:#9ca3af">sending...</span>';
      btn.disabled = true;
      try {
        var r = await fetch("/api/waitlist", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email }),
        });
        var data = await r.json().catch(function () { return {}; });
        if (r.ok && data.success) {
          msg.innerHTML = '<span style="color:#22c55e">✓ </span>' + (data.message || "You're on the list.");
          form.reset();
        } else {
          msg.innerHTML = '<span style="color:#ef4444">✕ </span>' + (data.message || "Something went wrong. Try again.");
        }
      } catch (err) {
        msg.innerHTML = '<span style="color:#ef4444">✕ </span>Network error. Try again.';
      } finally {
        btn.disabled = false;
      }
    });
  })();
</script>
