---
// Waitlist signup. POSTs to /api/waitlist on the same origin (Express handles).
// All client logic is inline — no framework runtime needed.
---
<form
  id="wl-form"
  class="mt-2 flex flex-wrap gap-2 items-stretch"
  action="/api/waitlist"
  method="post"
  novalidate
>
  <input
    type="email"
    name="email"
    required
    placeholder="you@example.org"
    autocomplete="email"
    class="bg-surface border border-border text-cream font-mono text-sm
           px-3 py-2 w-[260px] focus:border-green focus:outline-none transition-colors"
  />
  <button
    type="submit"
    class="bg-green text-bg font-semibold text-sm px-4 py-2
           hover:bg-green-hi transition-colors disabled:opacity-50"
  >
    join waitlist
  </button>
  <p id="wl-msg"
     class="basis-full text-xs font-mono mt-1 text-muted"
     role="status"
     aria-live="polite">
    <span class="text-dim">&gt; </span>no spam, ever. unsubscribe one-click.
  </p>
</form>
<script is:inline>
  (function () {
    var form = document.getElementById("wl-form");
    var msg  = document.getElementById("wl-msg");
    if (!form || !msg) return;
    form.addEventListener("submit", async function (ev) {
      ev.preventDefault();
      var email = (form.email && form.email.value || "").trim();
      var btn   = form.querySelector("button[type=submit]");
      msg.innerHTML = '<span style="color:#5e7055">&gt; </span>sending …';
      btn.disabled = true;
      try {
        var r = await fetch("/api/waitlist", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email }),
        });
        var data = await r.json().catch(function () { return {}; });
        if (r.ok && data.success) {
          msg.innerHTML = '<span style="color:#7dc48a">✓  </span>' + (data.message || "you’re on the list.");
          form.reset();
        } else {
          msg.innerHTML = '<span style="color:#a85a5a">✕  </span>' + (data.message || "something went wrong. try again.");
        }
      } catch (err) {
        msg.innerHTML = '<span style="color:#a85a5a">✕  </span>network error. try again.';
      } finally {
        btn.disabled = false;
      }
    });
  })();
</script>
